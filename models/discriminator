import torch
import torch.nn as nn

class PatchGANDiscriminator(nn.Module):
    """标准PatchGAN鉴别器（D1/D2/D3复用，仅输入尺寸不同：256x256/128x128/512x512）"""
    def __init__(self, in_channels=6, ndf=64, n_layers=3):
        super().__init__()
        # 第一层：无InstanceNorm（PatchGAN标准配置）
        layers = [
            nn.Conv2d(in_channels, ndf, kernel_size=4, stride=2, padding=1, padding_mode='reflect'),
            nn.LeakyReLU(0.2, inplace=True)
        ]
        # 中间下采样层
        nf_mult = 1
        for i in range(1, n_layers):
            nf_mult_prev = nf_mult
            nf_mult = min(2 ** i, 8)
            layers += [
                nn.Conv2d(ndf * nf_mult_prev, ndf * nf_mult, 4, 2, 1, padding_mode='reflect'),
                nn.InstanceNorm2d(ndf * nf_mult),
                nn.LeakyReLU(0.2, inplace=True)
            ]
        # 最后一层：1x1卷积输出1通道，无归一化/激活
        nf_mult_prev = nf_mult
        nf_mult = min(2 ** n_layers, 8)
        layers += [
            nn.Conv2d(ndf * nf_mult_prev, ndf * nf_mult, 4, 1, 1, padding_mode='reflect'),
            nn.InstanceNorm2d(ndf * nf_mult),
            nn.LeakyReLU(0.2, inplace=True),
            nn.Conv2d(ndf * nf_mult, 1, 4, 1, 1, padding_mode='reflect')
        ]
        self.model = nn.Sequential(*layers)

    def forward(self, x_real, x_fake):
        """输入：真实图+生成图（通道拼接），输出：Patch级真假判断图"""
        x = torch.cat([x_real, x_fake], dim=1)
        return self.model(x)