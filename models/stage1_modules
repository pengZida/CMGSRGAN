import torch
import torch.nn as nn
import torch.nn.functional as F
from .base_modules import RDB  # 导入基础RDB模块


class DualPathEncoding(nn.Module):
    """第一阶段：双路径编码模块（LR临床图+皮肤镜图分别编码）"""

    def __init__(self, in_channels=3):
        super().__init__()
        # LR临床图编码路径
        self.lr_conv1 = nn.Conv2d(in_channels, 64, 7, 1, 3, padding_mode='reflect')
        self.lr_in1 = nn.InstanceNorm2d(64)
        self.lr_conv2 = nn.Conv2d(64, 128, 3, 2, 1, padding_mode='reflect')
        self.lr_in2 = nn.InstanceNorm2d(128)
        self.lr_conv3 = nn.Conv2d(128, 256, 3, 2, 1, padding_mode='reflect')
        self.lr_in3 = nn.InstanceNorm2d(256)
        # 皮肤镜图编码路径
        self.de_conv1 = nn.Conv2d(in_channels, 64, 7, 2, 3, padding_mode='reflect')
        self.de_in1 = nn.InstanceNorm2d(64)
        self.de_conv2 = nn.Conv2d(64, 128, 3, 2, 1, padding_mode='reflect')
        self.de_in2 = nn.InstanceNorm2d(128)
        self.de_conv3 = nn.Conv2d(128, 256, 3, 2, 1, padding_mode='reflect')
        self.de_in3 = nn.InstanceNorm2d(256)
        self.de_conv4 = nn.Conv2d(256, 512, 3, 2, 1, padding_mode='reflect')
        self.de_in4 = nn.InstanceNorm2d(512)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, lr_img, de_img):
        lr_f1 = self.relu(self.lr_in1(self.lr_conv1(lr_img)))
        lr_f2 = self.relu(self.lr_in2(self.lr_conv2(lr_f1)))
        lr_f3 = self.relu(self.lr_in3(self.lr_conv3(lr_f2)))
        lr_feats = [lr_f1, lr_f2, lr_f3]

        de_f1 = self.relu(self.de_in1(self.de_conv1(de_img)))
        de_f2 = self.relu(self.de_in2(self.de_conv2(de_f1)))
        de_f3 = self.relu(self.de_in3(self.de_conv3(de_f2)))
        de_f4 = self.relu(self.de_in4(self.de_conv4(de_f3)))
        de_feats = [de_f1, de_f2, de_f3, de_f4]
        return lr_feats, de_feats


class MultiScaleFeaturePyramid(nn.Module):
    """第一阶段：多尺度特征金字塔模块（融合双路径编码特征）"""

    def __init__(self):
        super().__init__()
        # LR特征金字塔转换
        self.lr_conv1x1_scale3 = nn.Conv2d(256, 128, 1, 1, 0)
        self.lr_conv3x3_scale2 = nn.Conv2d(128, 64, 3, 1, 1, padding_mode='reflect')
        self.lr_conv3x3_scale1 = nn.Conv2d(64, 64, 3, 1, 1, padding_mode='reflect')
        # 皮肤镜特征金字塔转换
        self.de_conv1x1_scale3 = nn.Conv2d(512, 256, 1, 1, 0)
        self.de_conv3x3_scale2 = nn.Conv2d(256, 128, 3, 1, 1, padding_mode='reflect')
        self.de_conv3x3_scale1 = nn.Conv2d(128, 128, 3, 1, 1, padding_mode='reflect')

        self.upsample = nn.Upsample(scale_factor=2, mode='bilinear', align_corners=False)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, lr_feats, de_feats):
        lr_f1, lr_f2, lr_f3 = lr_feats
        de_f2, de_f3, de_f4 = de_feats[1], de_feats[2], de_feats[3]

        # LR特征金字塔构建
        lr_scale3 = self.relu(self.lr_conv1x1_scale3(lr_f3))
        lr_upsample3 = self.upsample(lr_scale3)
        lr_add2 = lr_upsample3 + lr_f2
        lr_scale2 = self.relu(self.lr_conv3x3_scale2(lr_add2))
        lr_upsample2 = self.upsample(lr_scale2)
        lr_add1 = lr_upsample2 + lr_f1
        lr_scale1 = self.relu(self.lr_conv3x3_scale1(lr_add1))
        lr_scales = [lr_scale1, lr_scale2, lr_scale3]

        # 皮肤镜特征金字塔构建
        de_scale3 = self.relu(self.de_conv1x1_scale3(de_f4))
        de_upsample3 = self.upsample(de_scale3)
        de_add2 = de_upsample3 + de_f3
        de_scale2 = self.relu(self.de_conv3x3_scale2(de_add2))
        de_upsample2 = self.upsample(de_scale2)
        de_add1 = de_upsample2 + de_f2
        de_scale1 = self.relu(self.de_conv3x3_scale1(de_add1))
        de_scales = [de_scale1, de_scale2, de_scale3]
        return lr_scales, de_scales


class HierarchicalCrossModalAttention(nn.Module):
    """第一阶段：分层跨模态注意力模块（多尺度特征交互）"""

    def __init__(self, lr_channels=[64, 64, 128], de_channels=[128, 128, 256], num_heads=4):
        super().__init__()
        self.num_scales = 3
        self.num_heads = num_heads
        self.q_proj = nn.ModuleList()
        self.kv_proj = nn.ModuleList()
        for i in range(self.num_scales):
            self.q_proj.append(nn.Conv2d(lr_channels[i], lr_channels[i], kernel_size=1, padding=0))
            self.kv_proj.append(nn.Conv2d(de_channels[i], lr_channels[i], kernel_size=1, padding=0))
        self.multihead_attn = nn.MultiheadAttention(embed_dim=lr_channels[0], num_heads=num_heads, batch_first=True)

    def _scale_attention_forward(self, lr_scale, de_scale, q_proj, kv_proj, attn_layer):
        B, C_lr, H, W = lr_scale.shape
        q = q_proj(lr_scale)
        kv = kv_proj(de_scale)
        q_seq = q.flatten(2).transpose(1, 2)
        kv_seq = kv.flatten(2).transpose(1, 2)
        if attn_layer.embed_dim != C_lr:
            attn_layer.embed_dim = C_lr
            attn_layer._reset_parameters()
        attn_output, _ = attn_layer(query=q_seq, key=kv_seq, value=kv_seq)
        weighted_feat = attn_output.transpose(1, 2).reshape(B, C_lr, H, W)
        return weighted_feat

    def forward(self, lr_scales, de_scales):
        weighted_feats = []
        for i in range(self.num_scales):
            wf = self._scale_attention_forward(
                lr_scale=lr_scales[i],
                de_scale=de_scales[i],
                q_proj=self.q_proj[i],
                kv_proj=self.kv_proj[i],
                attn_layer=self.multihead_attn
            )
            weighted_feats.append(wf)
        return weighted_feats[::-1]


class AdaptiveGatingFusion(nn.Module):
    """第一阶段：自适应门控融合模块（融合跨模态注意力特征）"""

    def __init__(self, wf_channels=[128, 64, 64], hidden_dim=128):
        super().__init__()
        self.upsample_2x = nn.Upsample(scale_factor=2, mode='bilinear', align_corners=False)
        self.upsample_to_128x128 = nn.Upsample(size=(128, 128), mode='bilinear', align_corners=False)

        concat_channels = sum(wf_channels)
        self.gap = nn.AdaptiveAvgPool2d(1)
        self.fc1 = nn.Linear(concat_channels, hidden_dim)
        self.fc2 = nn.Linear(hidden_dim, 3)
        self.relu = nn.ReLU(inplace=True)
        self.softmax = nn.Softmax(dim=1)

    def forward(self, weighted_feats):
        WF1, WF2, WF3 = weighted_feats
        WF1A = self.upsample_2x(self.upsample_2x(WF1))
        WF2A = self.upsample_2x(WF2)

        concat_feat = torch.cat([WF1A, WF2A, WF3], dim=1)
        gap_feat = self.gap(concat_feat).flatten(1)
        fc1_out = self.relu(self.fc1(gap_feat))
        fusion_weights = self.softmax(self.fc2(fc1_out))

        WF1_up = self.upsample_to_128x128(WF1)
        WF2_up = self.upsample_to_128x128(WF2)
        WF3_up = WF3
        WF1_up = F.conv2d(WF1_up, torch.ones(64, 128, 1, 1).to(WF1_up.device) / 128, padding=0)

        w = fusion_weights.unsqueeze(-1).unsqueeze(-1)
        fused_feat = w[:, 0:1] * WF1_up + w[:, 1:2] * WF2_up + w[:, 2:3] * WF3_up
        return fused_feat, fusion_weights


class FeatureRefinementUpsampling(nn.Module):
    """第一阶段：G1生成器（特征精修+上采样，输出256x256初始重建图）"""

    def __init__(self, in_channels=64, growth_rate=32, rdb_layers=4):
        super().__init__()
        self.rdb1 = RDB(in_channels, growth_rate, rdb_layers)
        self.rdb2 = RDB(in_channels, growth_rate, rdb_layers)
        self.upsample = nn.Upsample(scale_factor=2, mode='bilinear', align_corners=False)
        self.conv3x3 = nn.Conv2d(in_channels, in_channels, 3, 1, 1, padding_mode='reflect')
        self.conv7x7 = nn.Conv2d(in_channels, 3, 7, 1, 3, padding_mode='reflect')
        self.relu = nn.ReLU(inplace=True)
        self.tanh = nn.Tanh()

    def forward(self, fused_feat):
        feat = self.rdb1(fused_feat)
        feat = self.rdb2(feat)
        feat = self.upsample(feat)
        feat = self.relu(self.conv3x3(feat))
        recon_img = self.tanh(self.conv7x7(feat))
        return recon_img


class G2_DownSampling(nn.Module):
    """第一阶段：G2生成器（下采样，将G1输出的256x256降为128x128）"""

    def __init__(self, in_channels=3, out_channels=64):
        super().__init__()
        self.down_conv = nn.Conv2d(
            in_channels=in_channels,
            out_channels=out_channels,
            kernel_size=3,
            stride=2,
            padding=1,
            padding_mode='reflect'
        )
        self.in_norm = nn.InstanceNorm2d(out_channels)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, x):
        out = self.relu(self.in_norm(self.down_conv(x)))
        return out